{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": ["src", "README.md"],
    "includePattern": ".+\\.[jt]s(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": ["plugins/markdown", "node_modules/jsdoc-babel"],
  "babel": {
    "extensions": ["js", "jsx", "ts", "tsx"],
    "presets": ["@babel/preset-typescript", "@babel/preset-react"]
  },
  "opts": {
    "template": "node_modules/docdash",
    "encoding": "utf8",
    "destination": "./docs",
    "recurse": true,
    "readme": "README.md",
    "verbose": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "docdash": {
    "search": true,
    "collapse": true,
    "typedefs": true,
    "menu": {
      "Github Repo": {
        "href": "https://github.com/gaurav101/LuminaJS",
        "target": "_blank",
        "class": "menu-item",
        "id": "repository"
      },
      "Demo": {
        "href": "https://gaurav101.github.io/LuminaJS/",
        "target": "_blank",
        "class": "menu-item",
        "id": "demo"
      }
    }
  }
}
