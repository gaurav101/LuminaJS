{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@gks101/luminajs": ["src/index.js"],
      "@gks101/luminajs/react": ["src/react/index.ts"],
      "@gks101/luminajs/core": ["src/index.js"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
