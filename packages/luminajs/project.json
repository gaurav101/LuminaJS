{
  "name": "@gks101/luminajs",
  "root": "packages/luminajs",
  "sourceRoot": "packages/luminajs/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/luminajs && npm run build"
      },
      "outputs": ["{projectRoot}/dist", "{workspaceRoot}/docs"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/luminajs && npm run dev"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/luminajs && npm run test"
      }
    },
    "test-exports": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "cd packages/luminajs && npm run test:exports"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/luminajs && npm run lint"
      }
    },
    "generate-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/luminajs && npm run generate-docs"
      },
      "outputs": ["{workspaceRoot}/docs"]
    }
  },
  "tags": ["scope:library", "type:package"]
}
