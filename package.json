{
  "name": "@gks101/luminajs",
  "version": "2.0.0",
  "description": "A modular, lightweight JavaScript and react utility library and hooks/components for browser-based image processing using the HTML5 Canvas API. suppport react, typescript and vanilla js",
  "homepage": "https://gaurav101.github.io/LuminaJS/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaurav101/LuminaJS.git"
  },
  "bugs": {
    "url": "https://github.com/gaurav101/LuminaJS/issues"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/lumina.umd.js",
  "module": "./dist/lumina.esm.js",
  "browser": "./dist/lumina.umd.js",
  "unpkg": "./dist/lumina.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/lumina.umd.js"
    },
    "./filters": {
      "types": "./dist/types/filters/index.d.ts",
      "import": "./src/filters/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./src/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "rollup -c && npm run build:types && npm run generate-docs",
    "build:types": "tsc",
    "dev": "rollup -c -w",
    "start:demo": "npm run dev --prefix react-demo",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-docs": "jsdoc -c jsdoc.json"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "docdash": "^2.0.2",
    "jsdoc": "^4.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "react",
    "react-hooks",
    "react-component-image-filter",
    "react-hooks-image-filter",
    "react-image-processing",
    "react-filters",
    "react-canvas",
    "react-canvas-filters",
    "react-image-editor",
    "image-processing",
    "canvas",
    "filter",
    "grayscale",
    "sepia",
    "browser",
    "lightweight",
    "blur",
    "brightness",
    "contrast",
    "emboss",
    "edgeDetection",
    "gaussianBlur",
    "sharpen",
    "watermark",
    "backgroundBlur",
    "instagram-filters",
    "image-manipulation",
    "fast-blur",
    "ascii",
    "ascii art",
    "image-editor",
    "canvas-filters",
    "fast-gaussian-blur"
  ],
  "author": "LuminaJS and Gaurav",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  }
}