{
  "name": "@gks101/luminajs",
  "version": "1.4.1",
  "description": "A modular, lightweight JavaScript utility library for browser-based image processing using the HTML5 Canvas API.",
  "homepage": "https://gaurav101.github.io/LuminaJS/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaurav101/LuminaJS.git"
  },
  "bugs": {
    "url": "https://github.com/gaurav101/LuminaJS/issues"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/lumina.umd.js",
  "module": "./dist/lumina.esm.js",
  "browser": "./dist/lumina.umd.js",
  "unpkg": "./dist/lumina.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/lumina.umd.js"
    },
    "./filters": {
      "types": "./dist/types/filters/index.d.ts",
      "import": "./src/filters/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./src/core/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:core && npm run build:react",
    "build:core": "rollup -c && npm run build:types && npm run generate-docs",
    "build:react": "npm run build --prefix react-lumina",
    "build:types": "tsc",
    "dev": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-docs": "jsdoc -c jsdoc.json"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "docdash": "^2.0.2",
    "jsdoc": "^4.0.5",
    "rollup": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "image-processing",
    "canvas",
    "filter",
    "grayscale",
    "sepia",
    "browser",
    "lightweight",
    "blur",
    "brightness",
    "contrast",
    "emboss",
    "edgeDetection",
    "gaussianBlur",
    "sharpen",
    "watermark",
    "backgroundBlur",
    "instagram-filters",
    "image-manipulation",
    "fast-blur",
    "ascii",
    "ascii art",
    "image-editor",
    "canvas-filters",
    "fast-gaussian-blur"
  ],
  "author": "LuminaJS and Gaurav",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  }
}